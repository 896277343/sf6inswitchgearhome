WORDPRESS_URL="https://wordpress.com"
WORDPRESS_HOSTNAME="wordpress.com"

# If using the revalidate plugin
# You can generate by running `openssl rand -base64 32` in the terminal
WORDPRESS_WEBHOOK_SECRET="your-secret-key-here"

# Private Transposh Headless API; never prefix the secret with NEXT_PUBLIC_.
TRANSPOSH_API_URL="https://content.sf6.asia"
TRANSPOSH_HEADLESS_SECRET="replace-with-at-least-24-random-characters"
TRANSPOSH_TRANSLATE_STATIC_ON_BUILD="false"
PUBLISHED_LOCALES="en"
